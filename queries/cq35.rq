PREFIX cacao: <http://w3id.org/cacao/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?artefact ?contact ?label WHERE {
  ?artefact crm:P104_is_subject_to ?right .
  ?right cacao:CACAO_0000006 ?policy .
  VALUES ?ruleProperty { odrl:permission odrl:prohibition odrl:obligation }
  ?policy ?ruleProperty ?rule .
  ?rule odrl:assigner ?contact .
  OPTIONAL { ?contact rdfs:label ?label }
}
LIMIT 20
