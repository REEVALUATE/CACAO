        sh:nodeKind       sh:IRI ;
        sh:property       <https://astrea.linkeddata.es/shapes#50ee12d03373a78308e5484bd860ad98> , <https://astrea.linkeddata.es/shapes#196ea8d0591502158fa42bcdeb09377d> , <https://astrea.linkeddata.es/shapes#ad37c34a735811937bada118cc65cc69> ;
