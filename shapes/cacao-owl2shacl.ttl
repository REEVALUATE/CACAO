<https://astrea.linkeddata.es/shapes#89d4a83ff45a9d1358b6cba40acde07a>
        a               sh:NodeShape ;
        rdfs:label      "E64 结束"@zh , "E64 End of Existence"@en , "E64 Конeц Сущeствования"@ru , "E64 Fin d’existence"@fr , "E64 Fim da Existência"@pt , "E64 Τέλος Ύπαρξης"@el , "E64 Daseinsende"@de ;
        sh:description  "Scope note:\nThis class comprises events that end the existence of any instance of E77 Persistent Item. \nIt may be used for temporal reasoning about things (physical items, groups of people, living beings) ceasing to exist; it serves as a hook both a terminus post quem and a terminus ante quem. In cases where substance from an instance of E77 Persistent Item continues to exist in a new form, the process would be documented as instances of E81 Transformation.\n\nExamples:\n- the death of Snoopy, my dog (fictitious)\n- the melting of the snowman (E6)\n- the burning of the Temple of Artemis in Ephesos by Herostratos in 356 BC (E7, E6) (Trell, 1945)\n\nIn First Order Logic:\n- E64(x) ⇒ E5(x)\n"@en ;
        sh:name         "E64 Fin d’existence"@fr , "E64 结束"@zh , "E64 Daseinsende"@de , "E64 Конeц Сущeствования"@ru , "E64 Τέλος Ύπαρξης"@el , "E64 End of Existence"@en , "E64 Fim da Existência"@pt ;
        sh:nodeKind     sh:IRI ;
        sh:property     <https://astrea.linkeddata.es/shapes#2f302bd6977d174eabb9e015a7fa58a4> ;
        sh:targetClass  <http://www.cidoc-crm.org/cidoc-crm/E64_End_of_Existence> .

