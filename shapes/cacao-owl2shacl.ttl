<https://astrea.linkeddata.es/shapes#f1569d82a24734f2d5df36acdacf01bc>
        a                 sh:NodeShape ;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#> ;
        rdfs:label        "InstantaneousEvent" ;
        sh:description    "An instantaneous event, or event for short, happens in the world and marks a change in the world, in its activities and in its entities. The term 'event' is commonly used in process algebra with a similar meaning. Events represent communications or interactions; they are assumed to be atomic and instantaneous."@en ;
