        sh:name         "P90 有数值"@zh , "P90 имeeт значeниe"@ru , "P90 hat Wert"@de , "P90 a pour valeur"@fr , "P90 έχει τιμή"@el , "P90 tem valor"@pt , "P90 has value"@en ;
