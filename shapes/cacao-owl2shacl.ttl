        a               sh:PropertyShape ;
        rdfs:label      "P126 empregou"@pt , "P126 χρησιμοποίησε"@el , "Quantification: many to many (0,n:0,n)\n\nScope note:\nThis property identifies the instance of E57 Material employed in an instance of E11 Modification.\nThe instance of E57 Material used during the instance of E11 Modification does not necessarily become incorporated into the instance of E24 Physical Human-Made Thing that forms the subject of the instance of E11 Modification.\n\nExamples:\n- The repairing of the Queen Mary (E11) employed Steel (E57). [Beginning October 1942] (Britton, 2012)\n- Distilled water (E57) was employed in the restoration of the Sistine Chapel (E11). (Pietrangeli, 1986)\n\nIn First Order Logic:\n- P126(x,y) ⇒ E11(x)\n- P126(x,y) ⇒ E57(y)\n"@en , "P126 примeнял"@ru , "P126 verwendete"@de , "P126 employed"@en , "P126 使用"@zh , "P126 a employé"@fr ;
        sh:class        <http://www.cidoc-crm.org/cidoc-crm/E57_Material> ;
        sh:description  "Quantification: many to many (0,n:0,n)\n\nScope note:\nThis property identifies the instance of E57 Material employed in an instance of E11 Modification.\nThe instance of E57 Material used during the instance of E11 Modification does not necessarily become incorporated into the instance of E24 Physical Human-Made Thing that forms the subject of the instance of E11 Modification.\n\nExamples:\n- The repairing of the Queen Mary (E11) employed Steel (E57). [Beginning October 1942] (Britton, 2012)\n- Distilled water (E57) was employed in the restoration of the Sistine Chapel (E11). (Pietrangeli, 1986)\n\nIn First Order Logic:\n- P126(x,y) ⇒ E11(x)\n- P126(x,y) ⇒ E57(y)\n"@en ;
        sh:name         "P126 使用"@zh , "P126 verwendete"@de , "P126 примeнял"@ru , "P126 a employé"@fr , "P126 employed"@en , "P126 empregou"@pt , "P126 χρησιμοποίησε"@el ;
        sh:nodeKind     sh:BlankNodeOrIRI ;
        sh:path         <http://www.cidoc-crm.org/cidoc-crm/P126_employed> .

