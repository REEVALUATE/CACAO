        a               sh:PropertyShape ;
        rdfs:label      "P98 έφερε στη ζωή"@el , "Quantification: one to many, dependent (0,n:1,1)\n\nScope note:\nThis property links an instance of E67 Birth event to an instance of E21 Person in the role of offspring.\nTwins, triplets etc. are brought into life by the same instance of E67 Birth. This is not intended for use with general Natural History material, only people. There is no explicit method for modelling conception and gestation except by using extensions.\n\nExamples:\n- The Birth of Queen Elizabeth II (E67) brought into life Queen Elizabeth II (E21). (Parker, 2002)\n\nIn First Order Logic:\n- P98(x,y) ⇒ E67(x)\n- P98(x,y) ⇒ E21(y)\n- P98(x,y) ⇒ P92(x,y)\n"@en , "P98 诞生了"@zh , "P98 родил"@ru , "P98 a donné vie à"@fr , "P98 brachte zur Welt"@de , "P98 trouxe à vida"@pt , "P98 brought into life"@en ;
        sh:class        <http://www.cidoc-crm.org/cidoc-crm/E21_Person> ;
        sh:description  "Quantification: one to many, dependent (0,n:1,1)\n\nScope note:\nThis property links an instance of E67 Birth event to an instance of E21 Person in the role of offspring.\nTwins, triplets etc. are brought into life by the same instance of E67 Birth. This is not intended for use with general Natural History material, only people. There is no explicit method for modelling conception and gestation except by using extensions.\n\nExamples:\n- The Birth of Queen Elizabeth II (E67) brought into life Queen Elizabeth II (E21). (Parker, 2002)\n\nIn First Order Logic:\n- P98(x,y) ⇒ E67(x)\n- P98(x,y) ⇒ E21(y)\n- P98(x,y) ⇒ P92(x,y)\n"@en ;
        sh:name         "P98 诞生了"@zh , "P98 έφερε στη ζωή"@el , "P98 brachte zur Welt"@de , "P98 brought into life"@en , "P98 родил"@ru , "P98 trouxe à vida"@pt , "P98 a donné vie à"@fr ;
        sh:nodeKind     sh:BlankNodeOrIRI ;
        sh:path         <http://www.cidoc-crm.org/cidoc-crm/P98_brought_into_life> .

