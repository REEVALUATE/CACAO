<http://w3id.org/cacao/shapes/Association> a sh:NodeShape ;
    rdfs:label "Association" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    sh:description "An instance of prov:Association provides additional descriptions about the binary prov:wasAssociatedWith relation from an prov:Activity to some prov:Agent that had some responsiblity for it. For example, :baking prov:wasAssociatedWith :baker; prov:qualifiedAssociation [ a prov:Association; prov:agent :baker; :foo :bar ]."@en ;
    sh:name "Association" ;
    sh:nodeKind sh:IRI ;
    sh:property <http://w3id.org/cacao/shapes/hadPlan>,
        <http://w3id.org/cacao/shapes/hadRole> ;
    sh:targetClass prov:Association .

<http://w3id.org/cacao/shapes/Attribution> a sh:NodeShape ;
    rdfs:label "Attribution" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    sh:description "An instance of prov:Attribution provides additional descriptions about the binary prov:wasAttributedTo relation from an prov:Entity to some prov:Agent that had some responsible for it. For example, :cake prov:wasAttributedTo :baker; prov:qualifiedAttribution [ a prov:Attribution; prov:entity :baker; :foo :bar ]."@en ;
    sh:name "Attribution" ;
    sh:nodeKind sh:IRI ;
    sh:targetClass prov:Attribution .

<http://w3id.org/cacao/shapes/Bundle> a sh:NodeShape ;
