    sh:name "SoftwareAgent" ;
    sh:nodeKind sh:IRI ;
    sh:targetClass prov:SoftwareAgent .

<http://w3id.org/cacao/shapes/Specialty> a sh:NodeShape ;
    rdfs:label "Specialty"@en ;
    rdfs:isDefinedBy schema:Specialty ;
    sh:description "Any branch of a field in which people typically develop specific expertise, usually after significant study, time, and effort."@en ;
    sh:name "Specialty"@en ;
    sh:nodeKind sh:IRI ;
    sh:targetClass schema:Specialty .

<http://w3id.org/cacao/shapes/Start> a sh:NodeShape ;
    rdfs:label "Start" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    sh:description "An instance of prov:Start provides additional descriptions about the binary prov:wasStartedBy relation from some started prov:Activity to an prov:Entity that started it. For example, :foot_race prov:wasStartedBy :bang; prov:qualifiedStart [ a prov:Start; prov:entity :bang; :foo :bar; prov:atTime '2012-03-09T08:05:08-05:00'^^xsd:dateTime ] ."@en ;
    sh:name "Start" ;
    sh:nodeKind sh:IRI ;
    sh:property <http://w3id.org/cacao/shapes/hadActivity> ;
    sh:targetClass prov:Start .

