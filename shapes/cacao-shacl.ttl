<http://w3id.org/cacao/shapes/Plan> a sh:NodeShape ;
    rdfs:label "Plan" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    sh:description "There exist no prescriptive requirement on the nature of plans, their representation, the actions or steps they consist of, or their intended goals. Since plans may evolve over time, it may become necessary to track their provenance, so plans themselves are entities. Representing the plan explicitly in the provenance can be useful for various tasks: for example, to validate the execution as represented in the provenance record, to manage expectation failures, or to provide explanations."@en ;
    sh:name "Plan" ;
    sh:nodeKind sh:IRI ;
    sh:targetClass prov:Plan .

