<http://w3id.org/cacao/shapes/startedAtTime> a sh:PropertyShape ;
    rdfs:label "startedAtTime",
        "The time at which an activity started. See also prov:endedAtTime."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    sh:datatype xsd:dateTime ;
    sh:description "The time at which an activity started. See also prov:endedAtTime."@en ;
    sh:name "startedAtTime" ;
    sh:nodeKind sh:Literal ;
    sh:path prov:startedAtTime ;
    sh:pattern "-?([1-9][0-9]{3,}|0[0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?|(24:00:00(\\.0+)?))(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?" .

