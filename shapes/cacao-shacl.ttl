<http://w3id.org/cacao/shapes/Usage> a sh:NodeShape ;
    rdfs:label "Usage" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    sh:description "An instance of prov:Usage provides additional descriptions about the binary prov:used relation from some prov:Activity to an prov:Entity that it used. For example, :keynote prov:used :podium; prov:qualifiedUsage [ a prov:Usage; prov:entity :podium; :foo :bar ]."@en ;
    sh:name "Usage" ;
    sh:nodeKind sh:IRI ;
    sh:targetClass prov:Usage .

<http://w3id.org/cacao/shapes/WebPage> a sh:NodeShape ;
    rdfs:label "WebPage"@en ;
    rdfs:isDefinedBy schema:WebPage ;
    sh:description "A web page. Every web page is implicitly assumed to be declared to be of type WebPage, so the various properties about that webpage, such as <code>breadcrumb</code> may be used. We recommend explicit declaration if these properties are specified, but if they are found outside of an itemscope, they will be assumed to be about the page."@en ;
    sh:name "WebPage"@en ;
    sh:nodeKind sh:IRI ;
    sh:targetClass schema:WebPage .

<http://w3id.org/cacao/shapes/and> a sh:PropertyShape ;
    rdfs:label "And"@en ;
    rdfs:isDefinedBy odrl: ;
    sh:name "And"@en ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path odrl:and .

