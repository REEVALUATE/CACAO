- P69(x,y,z) ⇒ [P69(x,y) ∧ E55(z)]
"""@en ;
    sh:name "P69 ist verbunden mit"@de,
        "P69 σχετίζεται με"@el,
        "P69 has association with"@en,
        "P69 est associé à"@fr,
        "P69 é associado com"@pt,
        "P69 ассоциируeтся с"@ru,
        "P69 关联"@zh ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path <http://www.cidoc-crm.org/cidoc-crm/P69_has_association_with> .

