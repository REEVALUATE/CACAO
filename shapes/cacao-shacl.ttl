"""@en ;
    sh:name "P139 hat alternative Form"@de,
        "P139 έχει εναλλακτική μορφή"@el,
        "P139 has alternative form"@en,
        "P139 a pour forme alternative"@fr,
        "P139 tem forma alternativa"@pt,
        "P139 имeeт альтeрнативную форму"@ru,
        "P139 有交替形式"@zh ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path <http://www.cidoc-crm.org/cidoc-crm/P139_has_alternative_form> .

