    sh:description "If this Entity prov:wasRevisionOf Entity :e, then it can qualify how it was revised using prov:qualifiedRevision [ a prov:Revision;  prov:entity :e; :foo :bar ]."@en ;
    sh:name "qualifiedRevision" ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path prov:qualifiedRevision .

