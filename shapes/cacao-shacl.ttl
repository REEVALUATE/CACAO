    sh:name "ActivityInfluence" ;
    sh:nodeKind sh:IRI ;
    sh:not [ sh:class prov:EntityInfluence ] ;
    sh:property <http://w3id.org/cacao/shapes/activity>,
        <http://w3id.org/cacao/shapes/hadActivity> ;
    sh:targetClass prov:ActivityInfluence .

