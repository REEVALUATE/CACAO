        "P37 απέδωσε"@el,
        "P37 assigned"@en,
        "P37 a assigné"@fr,
        "P37 atribuiu"@pt,
        "P37 присвоил"@ru,
        "P37 分配了"@zh ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path <http://www.cidoc-crm.org/cidoc-crm/P37_assigned> .

