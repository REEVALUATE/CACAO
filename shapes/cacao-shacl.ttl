        "P13 κατέστρεψε"@el,
        "P13 destroyed"@en,
        "P13 a détruit"@fr,
        "P13 destruiu"@pt,
        "P13 уничтожил"@ru,
        "P13 破坏了"@zh ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path <http://www.cidoc-crm.org/cidoc-crm/P13_destroyed> .

