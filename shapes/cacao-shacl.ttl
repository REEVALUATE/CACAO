        <http://w3id.org/cacao/shapes/function>,
        <http://w3id.org/cacao/shapes/output>,
        <http://w3id.org/cacao/shapes/relation>,
        <http://w3id.org/cacao/shapes/target> ;
    sh:targetClass odrl:Rule .

