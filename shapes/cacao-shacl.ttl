<http://w3id.org/cacao/shapes/Quotation> a sh:NodeShape ;
    rdfs:label "Quotation" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    sh:description "An instance of prov:Quotation provides additional descriptions about the binary prov:wasQuotedFrom relation from some taken prov:Entity from an earlier, larger prov:Entity. For example, :here_is_looking_at_you_kid prov:wasQuotedFrom :casablanca_script; prov:qualifiedQuotation [ a prov:Quotation; prov:entity :casablanca_script; :foo :bar ]."@en ;
    sh:name "Quotation" ;
    sh:nodeKind sh:IRI ;
    sh:targetClass prov:Quotation .

