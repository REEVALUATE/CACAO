    sh:or ( [ sh:class schema:Role ;
                sh:path schema:roleName ] [ sh:class schema:Text ;
                sh:path schema:roleName ] [ sh:class schema:URL ;
                sh:path schema:roleName ] ) ;
    sh:path schema:roleName ;
    sh:targetClass <http://www.cidoc-crm.org/cidoc-crm/E39_Actor>,
        schema:Role .

