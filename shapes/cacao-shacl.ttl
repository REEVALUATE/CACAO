- P93(x,y) ⇒ P12(x,y)
"""@en ;
    sh:name "P93 beendete die Existenz von"@de,
        "P93 αναίρεσε"@el,
        "P93 took out of existence"@en,
        "P93 a mis fin à l’existence de"@fr,
        "P93 cessou a existência de"@pt,
        "P93 положил конeц сущeствованию"@ru,
        "P93 结束存在的是"@zh ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path <http://www.cidoc-crm.org/cidoc-crm/P93_took_out_of_existence> .

